# MongoDB connection string (required for login/signup/logout to work)
MONGODB_URI=your_mongodb_connection_string

# Secret used to sign JWTs (required)
JWT_SECRET=your_long_random_secret

# Used to build links inside verification emails (optional)
APP_URL=http://localhost:3000

# Resend (optional — signup works fine without it, verification email is just skipped)
RESEND_API_KEY=
EMAIL_FROM="INGLU <no-reply@inglu.in>"

# Google OAuth (optional — only needed for the "Sign in with Google" button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=

# Discord webhook — every form submission (contact, newsletter) posts here.
# Create one: Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=

# Google Sheet sync — deploy google-apps-script/Code.gs as a Web App and paste its URL here.
GOOGLE_SHEET_WEBHOOK_URL=
